{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "text",
    "input_mode",
    "status",
    "intention_type",
    "roles",
    "topic"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "input_mode": {
      "enum": [
        "authored_structured_request",
        "validated_natural_language"
      ]
    },
    "status": {
      "enum": [
        "ready",
        "ambiguous",
        "unsupported"
      ]
    },
    "intention_type": {
      "enum": [
        "compare",
        "predict",
        "unsupported"
      ]
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "population": {
          "type": "string",
          "minLength": 1
        },
        "measure_concept": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "grain": {
          "type": "string",
          "minLength": 1
        },
        "group_role": {
          "type": "string",
          "minLength": 1
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 2,
          "uniqueItems": true
        },
        "period": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "statistic": {
          "enum": [
            "documented",
            "mean",
            "unspecified",
            "documented_or_mean"
          ]
        }
      }
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    }
  }
}
