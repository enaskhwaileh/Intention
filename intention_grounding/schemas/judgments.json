{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "origin",
    "independently_reviewed",
    "corpus_sha256",
    "request_sha256",
    "judgments"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "origin": {
      "enum": [
        "annotation_candidate",
        "independent_human_review"
      ]
    },
    "independently_reviewed": {
      "type": "boolean"
    },
    "corpus_sha256": {
      "type": "string",
      "minLength": 1
    },
    "request_sha256": {
      "type": "string",
      "minLength": 1
    },
    "judgments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "table_id",
          "topical",
          "usefulness",
          "reviewer",
          "evidence"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "minLength": 1
          },
          "table_id": {
            "type": "string",
            "minLength": 1
          },
          "topical": {
            "enum": [
              "relevant",
              "not_relevant",
              "unresolved",
              "unjudged"
            ]
          },
          "usefulness": {
            "enum": [
              "useful",
              "not_useful",
              "unresolved",
              "unjudged"
            ]
          },
          "reviewer": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
