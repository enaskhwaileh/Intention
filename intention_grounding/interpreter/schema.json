{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "input_id": {
      "type": "string",
      "minLength": 1
    },
    "original_input": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      },
      "minItems": 1
    },
    "query_profile": {
      "type": "object",
      "properties": {
        "topics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          },
          "minItems": 0
        },
        "entities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          },
          "minItems": 0
        },
        "measures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          },
          "minItems": 0
        },
        "constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          },
          "minItems": 0
        }
      },
      "required": [
        "topics",
        "entities",
        "measures",
        "constraints"
      ],
      "additionalProperties": false
    },
    "intentions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/intention"
      },
      "minItems": 0
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      },
      "minItems": 0
    },
    "status": {
      "enum": [
        "unambiguous",
        "ambiguous",
        "insufficient",
        "unsupported"
      ]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "enum": [
          "MISSING_ARGUMENT",
          "UNRESOLVED_REFERENCE",
          "COMPETING_INTERPRETATIONS",
          "OUT_OF_SCOPE"
        ]
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "input_id",
    "original_input",
    "evidence",
    "query_profile",
    "intentions",
    "relationships",
    "status",
    "diagnostics"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "value": {
      "type": "object",
      "properties": {
        "literal": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "normalized": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string",
                  "minLength": 1
                },
                "rule_id": {
                  "enum": [
                    "casefold-v1",
                    "annual-v1"
                  ]
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1,
                  "uniqueItems": true
                }
              },
              "required": [
                "value",
                "rule_id",
                "evidence"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "literal",
        "evidence",
        "normalized"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "start",
        "end",
        "text"
      ],
      "additionalProperties": false
    },
    "argument": {
      "type": "object",
      "properties": {
        "role": {
          "enum": [
            "measure",
            "group_dimension",
            "groups",
            "subject",
            "time_points",
            "time_range",
            "time_grain",
            "population",
            "method",
            "threshold",
            "target",
            "other"
          ]
        },
        "value": {
          "$ref": "#/$defs/value"
        }
      },
      "required": [
        "role",
        "value"
      ],
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "$ref": "#/$defs/value"
        },
        "arguments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/argument"
          },
          "minItems": 0
        },
        "reading": {
          "type": "object",
          "properties": {
            "description": {
              "type": "string",
              "minLength": 1
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "required": [
            "description",
            "evidence"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "label",
        "arguments",
        "reading"
      ],
      "additionalProperties": false
    },
    "intention": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "expression": {
          "$ref": "#/$defs/value"
        },
        "arguments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/argument"
          },
          "minItems": 0
        },
        "missing": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "enum": [
                  "measure",
                  "group_dimension",
                  "groups",
                  "subject",
                  "time_points",
                  "time_range",
                  "time_grain",
                  "population",
                  "method",
                  "threshold",
                  "target",
                  "other"
                ]
              },
              "reason": {
                "enum": [
                  "not_stated",
                  "unresolved_reference"
                ]
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "required": [
              "role",
              "reason",
              "evidence"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/candidate"
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "expression",
        "arguments",
        "missing",
        "candidates"
      ],
      "additionalProperties": false
    },
    "relationship": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "single",
            "joint",
            "accepted_alternatives",
            "competing_interpretations"
          ]
        },
        "members": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "kind",
        "members",
        "evidence"
      ],
      "additionalProperties": false
    }
  }
}
