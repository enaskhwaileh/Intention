      ]
    },
    "series.raw": {
      "variant": "monitor.trend",
      "expression": "Order_t . Filter_F",
      "operators": [
        "Filter",
        "Order"
      ],
      "applicability": {
        "rule": "always"
      },
      "output": "Time-ordered values of m for the scope or each requested subject.",
      "hard": [
        "monitor.common.concept",
        "monitor.common.scope",
        "series.time",
        "series.numeric",
        "series.subjects",
        "series.length"
      ],
      "soft": [
        "series.grain",
        "series.completeness"
      ]
