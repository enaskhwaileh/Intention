  "operators": {
    "Filter": {
      "inputs": "rows",
      "outputs": "rows",
      "slots": [
        "F"
      ],
      "preconditions": [
        "Every scope restriction is evaluable on the rows."
      ],
      "missing_value_policy": "Rows whose scope attribute is missing are excluded and counted."
    },
    "Group": {
      "inputs": "rows",
      "outputs": "groups of rows",
      "slots": [
        "g"
      ],
      "preconditions": [
        "Rows carry a membership value for g."
      ],
      "missing_value_policy": "Rows with missing g are excluded and counted."
    },
    "Mean": {
      "inputs": "numeric values per group",
      "outputs": "one mean per group",
      "slots": [
        "m"
      ],
      "preconditions": [
        "Values are numeric observations on a meaningful arithmetic scale.",
        "At least one valid value per group."
      ],
      "missing_value_policy": "Available-case: declared missing values are excluded."
    },
    "Sum": {
      "inputs": "numeric values per group",
      "outputs": "one total per group",
      "slots": [
        "m"
      ],
      "preconditions": [
        "Values are additive over rows (not rates, means or cumulative totals)."
      ],
      "missing_value_policy": "Missing values are excluded and counted; no imputation."
    },
    "Project": {
      "inputs": "rows",
      "outputs": "selected attributes",
      "slots": [
        "m",
        "g"
      ],
      "preconditions": [
        "Selected attributes exist."
      ],
      "missing_value_policy": "Missing documented values remain missing."
    },
    "Lookup": {
      "inputs": "rows",
      "outputs": "one value per requested key",
      "slots": [
        "m",
        "G"
      ],
      "preconditions": [
        "Exactly one valid value per requested key in scope."
      ],
      "missing_value_policy": "A missing value makes the key unresolved; duplicates are not aggregated."
    },
    "Order": {
      "inputs": "rows",
      "outputs": "rows ordered by time",
      "slots": [
        "t"
      ],
      "preconditions": [
        "A parseable time attribute."
      ],
      "missing_value_policy": "Rows with missing time are excluded and counted."
    },
    "Fit": {
      "inputs": "labelled rows (X, y)",
      "outputs": "a fitted model",
      "slots": [
        "y",
        "X"
      ],
      "preconditions": [
        "Each row is one observation with an outcome label.",
        "The outcome varies.",
        "Features other than y exist."
      ],
      "missing_value_policy": "Rows with missing y are excluded; feature missingness is reported."
    },
    "Associate": {
      "inputs": "co-observed pairs (m, a)",
      "outputs": "an association statistic",
      "slots": [
        "m",
        "a"
      ],
      "preconditions": [
        "Both attributes are observed on the same rows and vary."
      ],
      "missing_value_policy": "Pairwise-complete rows."
    }
  },
  "procedures": {
    "means.raw": {
      "variant": "compare.group_means",
      "expression": "Mean_m . Group_g . Filter_F",
      "operators": [
        "Filter",
        "Group",
        "Mean"
      ],
      "applicability": {
        "rule": "excluded_if_statistic_mentions",
        "terms": [
          "reported",
          "documented",
          "published",
          "stored",
          "official"
        ]
      },
      "output": "Pairs (group, mean of m).",
      "sql": "SELECT <group>, AVG(<measure>) AS group_mean FROM <table> WHERE <scope> AND <valid_measure> GROUP BY <group>;",
      "hard": [
        "compare.common.concept",
        "compare.common.group_concept",
        "compare.common.scope",
        "compare.common.comparable",
        "means.raw.observation",
        "means.raw.membership",
        "means.raw.association",
        "means.raw.valid",
        "compare.common.groups"
      ],
      "soft": [
        "means.raw.completeness",
        "common.size"
      ]
    },
    "means.stored": {
      "variant": "compare.group_means",
      "expression": "Project_{g,m} . Filter_F",
      "operators": [
        "Filter",
        "Project"
      ],
      "applicability": {
        "rule": "excluded_if_statistic_mentions",
        "terms": [
          "raw",
          "individual",
          "observations",
          "records",
          "compute from"
        ]
      },
      "output": "Pairs (group, documented mean of m).",
      "sql": "SELECT <group>, <documented_mean> AS group_mean FROM <table> WHERE <scope> AND <valid_summary>;",
      "hard": [
        "compare.common.concept",
        "compare.common.group_concept",
        "compare.common.scope",
        "compare.common.comparable",
        "means.stored.summary",
        "means.stored.association",
        "means.stored.valid",
        "compare.common.groups"
      ],
      "soft": [
        "means.stored.completeness"
      ]
    },
    "values.lookup": {
      "variant": "compare.observed_values",
      "expression": "Lookup_{m,G} . Filter_F",
      "operators": [
        "Filter",
        "Lookup"
      ],
      "applicability": {
        "rule": "always"
      },
      "output": "Pairs (requested key, documented value of m).",
      "sql": "SELECT <key>, <measure> FROM <table> WHERE <scope> AND <key> IN (<groups>);",
      "hard": [
        "compare.common.concept",
        "compare.common.scope",
        "compare.common.comparable",
        "values.lookup.keys",
        "values.lookup.present",
        "values.lookup.valid"
      ],
      "soft": [
        "values.lookup.unique"
      ]
    },
    "totals.raw": {
      "variant": "aggregate.group_totals",
      "expression": "Sum_m . Group_g . Filter_F",
      "operators": [
        "Filter",
        "Group",
        "Sum"
      ],
      "applicability": {
        "rule": "excluded_if_statistic_mentions",
        "terms": [
          "reported",
          "documented",
          "published",
          "official"
        ]
      },
      "output": "Pairs (group, total of m), or one total for the scope.",
      "sql": "SELECT <group>, SUM(<measure>) AS total FROM <table> WHERE <scope> AND <valid_measure> GROUP BY <group>;",
      "hard": [
        "aggregate.common.concept",
        "aggregate.common.scope",
        "totals.raw.additive",
        "totals.raw.grouping",
        "totals.raw.valid"
      ],
      "soft": [
        "totals.raw.completeness",
        "common.size"
      ]
    },
    "totals.stored": {
      "variant": "aggregate.group_totals",
      "expression": "Project_{g,m} . Filter_F",
      "operators": [
        "Filter",
        "Project"
      ],
      "applicability": {
        "rule": "excluded_if_statistic_mentions",
        "terms": [
          "raw",
          "individual",
          "records",
          "compute from"
        ]
      },
      "output": "Pairs (group, documented total of m).",
      "sql": "SELECT <group>, <documented_total> FROM <table> WHERE <scope> AND <valid_summary>;",
      "hard": [
        "aggregate.common.concept",
        "aggregate.common.scope",
        "totals.stored.summary",
        "totals.stored.grouping",
        "totals.stored.valid"
      ],
      "soft": []
    },
    "learn.classifier": {
      "variant": "predict.classification",
      "expression": "Fit_{y,X} . Filter_F",
      "operators": [
        "Filter",
        "Fit"
      ],
      "applicability": {
        "rule": "always"
