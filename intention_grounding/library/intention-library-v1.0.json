  "requirements": {
    "compare.common.concept": {
      "origin": "intention",
      "axis": "sem",
      "predicate": "concept_bound",
      "params": {
        "concept": "$measure",
        "slot": "measure"
      },
      "evidence_rule": "binding",
      "rationale": "The comparison outcome is defined for the requested measure."
    },
    "compare.common.group_concept": {
      "origin": "intention",
      "axis": "sem",
      "predicate": "concept_bound",
      "params": {
        "concept": "$group_dimension",
        "slot": "group",
        "kind": "dimension",
        "values": "$groups"
      },
      "evidence_rule": "binding",
      "rationale": "Groups are defined by the requested comparison dimension."
    },
    "compare.common.scope": {
      "origin": "Filter",
      "axis": "cov",
      "predicate": "scope_satisfiable",
      "params": {
        "scope": "$scope"
      },
      "evidence_rule": "scoped_values",
      "rationale": "Filter's selection contract: observations within the requested scope are identifiable."
    },
    "compare.common.comparable": {
      "origin": "intention",
      "axis": "sem",
      "predicate": "single_definition",
      "params": {
        "slot": "measure"
      },
      "evidence_rule": "binding",
      "rationale": "Group results use one measure definition and unit."
    },
    "compare.common.groups": {
      "origin": "intention",
      "axis": "cov",
      "predicate": "groups_covered",
      "params": {
        "slot": "group",
        "groups": "$groups",
        "min_groups": 2,
        "valid_slot": "measure"
      },
      "evidence_rule": "scoped_counts",
      "rationale": "At least two groups have results, including every explicitly requested group."
    },
    "means.raw.observation": {
      "origin": "Mean",
      "axis": "str",
      "predicate": "observation_level",
      "params": {
        "slot": "measure"
      },
      "evidence_rule": "measure_kind",
      "rationale": "Mean input contract: each contributing value is an observation, not an existing summary (rate, mean or cumulative total)."
    },
    "means.raw.membership": {
      "origin": "Group",
      "axis": "str",
      "predicate": "categorical_membership",
      "params": {
        "slot": "group"
      },
      "evidence_rule": "profile",
      "rationale": "Selected observations carry a discrete group membership."
    },
    "means.raw.association": {
      "origin": "composition",
      "axis": "str",
      "predicate": "co_located",
      "params": {
        "slots": [
          "measure",
          "group"
        ]
      },
      "evidence_rule": "profile",
      "rationale": "Measure and group refer to the same row (Filter-Group-Mean dependency)."
    },
    "means.raw.valid": {
      "origin": "Mean",
      "axis": "aff",
      "predicate": "valid_per_group",
      "params": {
        "slot": "measure",
        "group_slot": "group",
        "groups": "$groups",
        "min_valid": 1
      },
      "evidence_rule": "scoped_counts",
      "rationale": "A defined arithmetic mean requires a nonempty set of valid numerical inputs for every included group."
    },
    "means.raw.completeness": {
      "origin": "Mean",
      "axis": "qual",
      "kind": "soft",
      "predicate": "completeness",
      "params": {
        "slot": "measure"
      },
      "evidence_rule": "profile",
      "rationale": "Valid-value completeness of the measure."
    },
    "means.stored.summary": {
      "origin": "Project",
      "axis": "aff",
      "predicate": "summary_kind",
      "params": {
        "slot": "measure",
        "kinds": [
          "mean"
        ]
      },
      "evidence_rule": "measure_kind",
      "rationale": "Selected values are documented arithmetic means of the measure."
    },
    "means.stored.association": {
      "origin": "composition",
      "axis": "str",
      "predicate": "co_located",
      "params": {
        "slots": [
          "measure",
          "group"
        ]
      },
      "evidence_rule": "profile",
      "rationale": "Each documented mean is linked to its group."
    },
    "means.stored.valid": {
      "origin": "Project",
      "axis": "aff",
      "predicate": "valid_per_group",
      "params": {
