{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"intention.interpretation.v1",
  "type":"object","additionalProperties":false,
  "required":["schema_version","action","arguments","topical","provenance","ambiguity"],
  "properties":{
    "schema_version":{"const":"1.0.0"},
    "action":{"enum":["COMPARE","AGGREGATE","PREDICT","EXPLAIN","MONITOR","unknown"]},
    "arguments":{"type":"object","additionalProperties":{"type":["string","number","boolean"]}},
    "topical":{"type":"object","additionalProperties":false,"required":["query","entities","attributes","constraints"],"properties":{"query":{"type":"string","minLength":1},"entities":{"type":"array","items":{"type":"string"}},"attributes":{"type":"array","items":{"type":"string"}},"constraints":{"type":"object"}}},
    "provenance":{"type":"object","additionalProperties":false,"required":["topic_spans","action_spans","argument_spans"],"properties":{"topic_spans":{"type":"array","items":{"$ref":"#/$defs/span"}},"action_spans":{"type":"array","items":{"$ref":"#/$defs/span"}},"argument_spans":{"type":"object","additionalProperties":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/span"}}}}},
    "ambiguity":{"type":"object","additionalProperties":false,"required":["status","candidates","reason"],"properties":{"status":{"enum":["unambiguous","ambiguous","insufficient"]},"candidates":{"type":"array","items":{"enum":["COMPARE","AGGREGATE","PREDICT","EXPLAIN","MONITOR"]}},"reason":{"type":["string","null"]}}}
  },
  "$defs":{"span":{"type":"object","additionalProperties":false,"required":["start","end","text"],"properties":{"start":{"type":"integer","minimum":0},"end":{"type":"integer","minimum":0},"text":{"type":"string"}}}}
}
